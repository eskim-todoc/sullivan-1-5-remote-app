<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    -->

    <!-- 안드로이드 12 (SDK 버전 31) 이상에서는 아래의 블루투스 권한을 사용한다. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />

    <!-- 블루투스 페어링 키 자동 입력을 위한 권한을 사용한다.
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    -->

    <!-- 안드로이드 11 (SDK 버전 30) 이하에서는 아래의 블루투스 권한을 사용한다. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 위치 권한 역시 안드로이드 11 (SDK 버전 30) 이하에서만 사용된다. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 안드로이드 10, 11 (SDK 버전 29, 30)에서는 블루투스 검색 시 아래의 백그라운드 위치 권한이 필요하다. -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        android:maxSdkVersion="30" />

    <!-- 강제 종료 포착 서비스를 위한 포그라운드 서비스 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 진동 기능을 위한 권한 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 외부 저장소 권한 (안드로이드 10, API29, Q 이하) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!--
    모든 파일 접근 권한 (안드로이드 11, API30 이상)

    OTA 이미지를 /sdcard/OTA/ 에서 File API 로 직접 읽기 위해 필요하다.
    안드로이드 11부터 scoped storage 가 강제되어, 앱 전용 폴더(Android/data/) 밖의
    비(非)미디어 파일은 이 권한 없이는 열 수 없다.

    앱 전용 폴더를 쓰면 이 권한이 필요 없지만, 그 폴더는 안드로이드 11부터
    MTP(USB) 에서 숨겨져 윈도우 탐색기로 파일을 넣을 수 없다.
    윈도우에서 복사/붙여넣기로 이미지를 넣는 방식을 유지하려고 이 권한을 사용한다.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/app_theme"
        tools:targetApi="30">
        <service
            android:name="todoc.cochlear.remoteapp.service.ExitCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <!--
        화면 방향은 매니페스트로 고정하지 않는다. 폰이면 세로, 태블릿이면 가로로
        «실행할 때» 정해야 하므로 코드에서 건다 (MainActivity.applyScreenOrientation).

        configChanges 를 선언하는 이유는 두 가지다.
          1) 방향을 코드로 걸 때 액티비티가 재생성되지 않는다
          2) 폴더블을 접거나 펴도 재생성되지 않아, 바꿀지 말지를 앱이 직접 정할 수 있다
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>