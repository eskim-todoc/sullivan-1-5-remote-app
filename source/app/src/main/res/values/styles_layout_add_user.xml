<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="add_user_subject_textview">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:gravity">start|bottom</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:textColor">@color/color_secondary_variant</item>
    </style>

    <style name="add_user_button" parent="@style/Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:textColor">@color/color_secondary</item>
        <item name="strokeColor">@color/color_secondary_variant</item>
    </style>

    <style name="add_user_screen_dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
    </style>
</resources>