<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="remote_control_up_image_button">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/remote_control_ic_up_24dp</item>
        <item name="android:background">
            @drawable/remote_control_button_ripple_round_top_background
        </item>
        <item name="tint">@color/color_on_primary</item>
    </style>

    <style name="remote_control_down_image_button">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/remote_control_ic_down_24dp</item>
        <item name="android:background">
            @drawable/remote_control_button_ripple_round_bottom_background
        </item>
        <item name="tint">@color/color_on_primary</item>
    </style>

    <style name="remote_control_circle_image_button">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">
            @drawable/remote_control_ic_ripple_circle_background
        </item>
        <item name="tint">@color/color_on_primary</item>
    </style>

    <style name="remote_control_button_title_textview">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:textColor">@color/color_secondary_variant</item>
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="remote_control_chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/remote_control_chip_background_selector</item>
        <item name="android:textColor">@color/remote_control_chip_text_selector</item>
        <item name="android:elevation">4dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>