<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="app_theme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Base colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_secondary_variant</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnError">@color/color_on_error</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/color_primary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/color_primary</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/color_background</item>
    </style>

    <style name="TextAppearance.RemoteControl.Default.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="TextAppearance.RemoteControl.Controller.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="lock_screen_number" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Headline5
        </item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <style name="lock_screen_circle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="lock_screen_dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
    </style>

    <style name="settings_lock_screen_switch" parent="@style/Widget.MaterialComponents.CompoundButton.Switch">
        <item name="materialThemeOverlay">@style/settings_lock_screen_switch_overlay</item>
        <item name="android:textColor">@color/color_on_background</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="settings_lock_screen_switch_overlay">
        <!--
        <item name="colorSurface">@color/color_secondary</item>
        <item name="colorOnSurface">@color/color_secondary_variant</item>
        <item name="colorSecondary">@color/color_error</item>
        -->
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
    </style>

    <style name="settings_subject_textview">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:gravity">start|bottom</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:textColor">@color/color_on_background</item>
    </style>

    <style name="settings_button" parent="@style/Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:textColor">@color/color_on_background</item>
    </style>

    <style name="settings_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="management_user_subject_textview">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:gravity">start|bottom</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:textColor">@color/color_secondary_variant</item>
    </style>

    <style name="add_user_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <!-- 툴바 테마 -->
    <style name="MyToolbarPopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="iconTint">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:colorBackground">@color/white</item>
    </style>

    <!-- 경고 다이얼로그 테마 -->
    <style name="MyAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColorPrimary">#1E1E1E</item>
        <item name="android:textColor">#1E1E1E</item>
        <item name="android:colorAccent">#E91E63</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MyAlertDialogPositiveButtonTheme
        </item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MyAlertDialogNegaitiveButtonTheme
        </item>
    </style>

    <!-- 다이얼로그 긍정 버튼 테마 -->
    <style name="MyAlertDialogPositiveButtonTheme" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#E91E63</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 다이얼로그 부정 버튼 테마 -->
    <style name="MyAlertDialogNegaitiveButtonTheme" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#E91E63</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 사용자 관리 화면 주제 텍스트 테마 -->
    <style name="ManagementUserSubjectTextviewTheme" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font_app_font</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/management_user_table_subject_background</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- 사용자 관리 화면 값 레이아웃 테마 -->
    <style name="ManagementUserValueTextviewTheme">
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/management_user_table_value_background</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- 앱 잠금화면 관련 -->
    <style name="AppLockPasswordTextViewTheme">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/applock_password_textview_background</item>
        <item name="android:fontFamily">@font/applock_font</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#004D40</item>
        <item name="android:textSize">28dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppLockScreenTableRowTheme">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="AppLockScreenNumButtonTheme" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/applock_font</item>
        <item name="android:textColor">@drawable/app_lock_number_text_selector</item>
        <item name="android:textSize">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:onClick">onClickPassNumClicked</item>
    </style>

    <style name="AppLockScreenDelImageButtonTheme" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/ic_round_backspace_24</item>
        <item name="android:onClick">onClickPassNumDelete</item>
    </style>
</resources>