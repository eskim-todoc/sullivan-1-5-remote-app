<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="app_theme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 상태바 색상 -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <!-- 하단 네비게이션바 색상 -->
        <item name="android:navigationBarColor">@color/bottom_navigation</item>
        <!-- 앱 폰트 설정 -->
        <item name="android:fontFamily">@font/nanum_gothic_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="colorSurface">@color/white_90</item>
        <item name="colorSecondary">@color/accent_70</item>
        <item name="colorOnSurface">@color/white_70</item>
        <item name="colorPrimary">@color/black_30</item>
        <item name="colorOnPrimary">@color/accent_70</item>
        <!-- 에디트텍스트 스타일 -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <!-- 다이얼로그 스타일 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <!-- 에디트 텍스트 스타일 -->
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="hintTextColor">@color/accent_70</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="helperTextTextColor">@color/white_70</item>
        <item name="counterTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="counterTextColor">@color/white_70</item>
        <item name="errorTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="errorTextColor">@color/error_100</item>
        <item name="boxBackgroundColor">@color/white_40</item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayout" parent="">
        <item name="colorPrimary">@color/accent_70</item>
        <item name="colorSurface">@color/black_30</item>
        <item name="colorOnSurface">@color/white_90</item>
        <item name="android:textColorPrimary">@color/white_90</item>
        <item name="colorError">@color/error_100</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.App.Subtitle1</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox
        </item>
    </style>

    <!-- 이 녀석은 에디트텍스트와 다이얼로그에서 공통으로 사용함 -->
    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">2dp</item>
    </style>

    <!-- 이 녀석은 에디트텍스트와 다이얼로그에서 공통으로 사용함 -->
    <style name="TextAppearance.App.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16dp</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12dp</item>
    </style>

    <style name="TextAppearance.App.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14dp</item>
    </style>

    <!-- 다이얼로그 스타일 -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent_70</item>
        <item name="colorSecondary">@color/error_100</item>
        <item name="colorSurface">@color/black_10</item>
        <item name="colorOnSurface">@color/black_90</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title.Text
        </item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body.Text
        </item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.NegativeButton</item>
        <item name="checkedTextViewStyle">@style/MaterialAlertDialog.App.CheckedTextView</item>
    </style>

    <style name="MaterialAlertDialog.App.CheckedTextView" parent="@style/Widget.MaterialComponents.CheckedTextView">
        <item name="android:textColor">@color/black_90</item>
        <item name="android:textSize">14dp</item>
    </style>

    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.App.MediumComponent</item>
    </style>

    <style name="MaterialAlertDialog.App.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/black_90</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="MaterialAlertDialog.App.Body.Text" parent="">
        <item name="android:textColor">@color/black_90</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textSize">14dp</item>
    </style>

    <style name="Widget.App.PositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Button.PositiveTextButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
    </style>

    <style name="Widget.App.NegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Button.NegativeTextButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
    </style>

    <style name="ThemeOverlay.App.Button.PositiveTextButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="colorPrimary">@color/black_90</item>
    </style>

    <style name="ThemeOverlay.App.Button.NegativeTextButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="colorPrimary">@color/error_100</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">2dp</item>
    </style>

    <!-- 잠금화면 번호 스타일 -->
    <style name="RemoteControl.LockScreen.NumberText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/white_90</item>
        <item name="android:textSize">24dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- 잠금화면 번호 스타일 -->
    <style name="RemoteControl.LockScreen.CircleImage" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <!-- 리모컨 화면 동그란 (ON/OFF) 이미지 버튼 -->
    <style name="RemoteControl.RemoteControl.CircleButton" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">
            @drawable/remote_control_ic_ripple_circle_background
        </item>
        <!--
        <item name="tint">@color/color_on_primary</item>
        -->
    </style>
    <!--
    * ****************************************************************************************************
    * ****************************************************************************************************
    * ****************************************************************************************************
    * ****************************************************************************************************
    -->

    <!-- 기타 -->
</resources>