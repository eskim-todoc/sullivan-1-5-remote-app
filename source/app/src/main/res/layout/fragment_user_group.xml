<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/remote_control_background_glass" android:overScrollMode="never" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/remote_glass_panel">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/group_initials_layout" android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:errorTextAppearance="@style/TextAppearance.App.FormError" app:errorTextColor="@color/profile_error_amber" app:errorIconTint="@color/profile_error_amber">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/group_initials" android:layout_width="match_parent" android:layout_height="48dp" android:hint="사용자 이니셜" android:inputType="text" android:singleLine="true" android:background="@null" android:fontFamily="@font/app_sans" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:boxBackgroundMode="none">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/group_alias" android:layout_width="match_parent" android:layout_height="48dp" android:hint="별칭 (선택)" android:inputType="text" android:singleLine="true" android:background="@null" android:fontFamily="@font/app_sans" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="장치 이름과 같은 이니셜을 입력하세요. 키를 입력한 쪽을 등록하며, 체크한 쪽만 자동 연결합니다." android:textColor="@color/white_80" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/remote_glass_panel">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="왼쪽 · L" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/group_left_key_layout" android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:errorTextAppearance="@style/TextAppearance.App.FormError" app:errorTextColor="@color/profile_error_amber" app:errorIconTint="@color/profile_error_amber">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/group_left_key" android:layout_width="match_parent" android:layout_height="48dp" android:hint="내부기 키 4자리" android:inputType="textVisiblePassword" android:maxLength="4" android:singleLine="true" android:background="@null" android:textColor="@color/white_90" android:textColorHint="#AEBEC7" android:fontFamily="@font/app_sans" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="8dp" android:paddingBottom="4dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/group_left_active" android:layout_width="match_parent" android:layout_height="44dp" android:text="자동 연결" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/remote_glass_panel">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오른쪽 · R" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/group_right_key_layout" android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:errorTextAppearance="@style/TextAppearance.App.FormError" app:errorTextColor="@color/profile_error_amber" app:errorIconTint="@color/profile_error_amber">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/group_right_key" android:layout_width="match_parent" android:layout_height="48dp" android:hint="내부기 키 4자리" android:inputType="textVisiblePassword" android:maxLength="4" android:singleLine="true" android:background="@null" android:textColor="@color/white_90" android:textColorHint="#AEBEC7" android:fontFamily="@font/app_sans" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="8dp" android:paddingBottom="4dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/group_right_active" android:layout_width="match_parent" android:layout_height="44dp" android:text="자동 연결" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/group_add_factory" android:layout_width="match_parent" android:layout_height="40dp" android:minHeight="0dp" android:layout_marginTop="8dp" android:text="초기화 장치 키 추가" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:textColor="@color/white_80" android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
            <LinearLayout android:id="@+id/group_factory_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="10dp" android:background="@drawable/remote_glass_panel" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="초기화 장치 · F" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/group_factory_key_layout" android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:errorTextAppearance="@style/TextAppearance.App.FormError" app:errorTextColor="@color/profile_error_amber" app:errorIconTint="@color/profile_error_amber">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/group_factory_key" android:layout_width="match_parent" android:layout_height="48dp" android:hint="내부기 키 4자리" android:inputType="textVisiblePassword" android:maxLength="4" android:singleLine="true" android:background="@null" android:textColor="@color/white_90" android:textColorHint="#AEBEC7" android:fontFamily="@font/app_sans" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="8dp" android:paddingBottom="4dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/group_factory_active" android:layout_width="match_parent" android:layout_height="44dp" android:text="자동 연결" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:includeFontPadding="false" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/group_delete" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="삭제" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:textColor="@color/white_90" android:background="@drawable/app_glass_danger" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/group_save" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="등록" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:textColor="@color/white_90" android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
