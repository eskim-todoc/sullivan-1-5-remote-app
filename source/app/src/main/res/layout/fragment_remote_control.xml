<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="todoc.cochlear.remoteapp.fragment.RemoteControlFragment">

        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />

        <!-- Body -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/remote_control_body_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/black_70"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/remote_control_connection_user_name_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textAlignment="center"
                android:textColor="@color/white_90"
                android:textSize="24dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_battery_progressbar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="은수의 왼쪽" />

            <ImageView
                android:id="@+id/remote_control_device_background_imageview"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/remote_control_device_background_image"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/remote_control_notification_image_button"
                app:layout_constraintEnd_toStartOf="@id/remote_control_led_image_button"
                app:layout_constraintTop_toBottomOf="@id/remote_control_connection_user_name_textview" />

            <ImageView
                android:id="@+id/remote_control_device_imageview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:src="@drawable/ote_png_image"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_device_background_imageview"
                app:layout_constraintEnd_toEndOf="@id/remote_control_device_background_imageview"
                app:layout_constraintStart_toStartOf="@id/remote_control_device_background_imageview"
                app:layout_constraintTop_toTopOf="@id/remote_control_device_background_imageview" />

            <ProgressBar
                android:id="@+id/remote_control_battery_progressbar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="112dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:elevation="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/custom_progressbar_battery_level"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@id/remote_control_notification_image_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/remote_control_connection_user_name_textview"
                tools:progress="22" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="18dp"
                android:contentDescription=""
                android:elevation="8dp"
                android:src="@drawable/drawable_home_battery_tap"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_battery_progressbar"
                app:layout_constraintStart_toEndOf="@id/remote_control_battery_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_battery_progressbar" />

            <TextView
                android:id="@+id/remote_control_battery_percent_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:elevation="8dp"
                android:text=""
                android:textColor="@color/black_90"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_battery_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_battery_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_battery_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_battery_progressbar"
                tools:text="22" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp"
                android:elevation="8dp"
                android:text="%"
                android:textColor="@color/black_90"
                android:textSize="18dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_battery_percent_textview"
                app:layout_constraintStart_toEndOf="@id/remote_control_battery_percent_textview" />

            <ImageButton
                android:id="@+id/remote_control_notification_image_button"
                style="@style/RemoteControl.RemoteControl.CircleButton"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/remote_control_ic_notifications_24dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_program_down_image_button"
                app:layout_constraintEnd_toStartOf="@id/remote_control_led_image_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/remote_control_battery_progressbar" />

            <ImageButton
                android:id="@+id/remote_control_led_image_button"
                style="@style/RemoteControl.RemoteControl.CircleButton"
                android:src="@drawable/remote_control_ic_light_24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_notification_image_button"
                app:layout_constraintEnd_toStartOf="@id/remote_control_telecoil_image_button"
                app:layout_constraintStart_toEndOf="@id/remote_control_notification_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_notification_image_button" />

            <ImageButton
                android:id="@+id/remote_control_telecoil_image_button"
                style="@style/RemoteControl.RemoteControl.CircleButton"
                android:src="@drawable/remote_control_ic_telecoil_24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_notification_image_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/remote_control_led_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_notification_image_button" />

            <TextView
                android:id="@+id/remote_control_notification_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="알림"
                android:textColor="@color/white_70"
                android:textSize="14dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_notification_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_notification_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_notification_image_button" />

            <TextView
                android:id="@+id/remote_control_led_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="LED"
                android:textColor="@color/white_70"
                android:textSize="14dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_led_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_led_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_led_image_button" />

            <TextView
                android:id="@+id/remote_control_telecoil_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="텔레코일"
                android:textColor="@color/white_70"
                android:textSize="14dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_telecoil_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_telecoil_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_telecoil_image_button" />

            <TextView
                android:id="@+id/remote_control_program_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="프로그램"
                android:textColor="@color/white_70"
                android:textSize="14dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_program_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_program_up_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_program_down_image_button" />

            <TextView
                android:id="@+id/remote_control_program_value_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:text=""
                android:textColor="@color/black_90"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_program_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_program_up_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_program_down_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_program_down_image_button"
                tools:text="2" />

            <ImageButton
                android:id="@+id/remote_control_program_down_image_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/remote_control_program_down_button"
                app:layout_constraintBottom_toTopOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintEnd_toStartOf="@id/remote_control_program_up_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_notification_image_button"
                app:layout_constraintTop_toBottomOf="@id/remote_control_notification_image_button" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/remote_control_ic_left_24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_program_down_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_program_down_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_program_down_image_button" />

            <ImageButton
                android:id="@+id/remote_control_program_up_image_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:background="@drawable/remote_control_program_up_button"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_program_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_telecoil_image_button"
                app:layout_constraintStart_toEndOf="@id/remote_control_program_down_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_program_down_image_button" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/remote_control_ic_right_24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_program_up_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_program_up_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_program_up_image_button" />

            <ProgressBar
                android:id="@+id/remote_control_max_output_progressbar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="8dp"
                android:max="4"
                android:progress="2"
                android:progressDrawable="@drawable/remote_control_imagebutton_background_progressbar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/remote_control_volume_progressbar"
                app:layout_constraintHeight_max="168dp"
                app:layout_constraintHeight_min="160dp"
                app:layout_constraintStart_toStartOf="@id/remote_control_notification_image_button"
                app:layout_constraintTop_toBottomOf="@id/remote_control_program_down_image_button" />

            <ImageButton
                android:id="@+id/remote_control_max_output_up_image_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/remote_control_button_ripple_round_top_background"
                android:elevation="8dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_max_output_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_max_output_progressbar" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:elevation="8dp"
                android:src="@drawable/remote_control_ic_up_24dp"
                app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_up_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_max_output_up_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_max_output_up_image_button" />

            <ImageButton
                android:id="@+id/remote_control_max_output_down_image_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/remote_control_button_ripple_round_bottom_background"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintTop_toBottomOf="@id/remote_control_max_output_up_image_button" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent"
                android:elevation="8dp"
                android:src="@drawable/remote_control_ic_down_24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_max_output_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_down_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_max_output_down_image_button" />

            <TextView
                android:id="@+id/remote_control_max_output_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="최대출력"
                android:textColor="@color/white_70"
                android:textSize="14dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_max_output_progressbar" />

            <TextView
                android:id="@+id/remote_control_max_output_value_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:text=""
                android:textColor="@color/black_90"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_max_output_progressbar"
                tools:text="80%" />

            <ProgressBar
                android:id="@+id/remote_control_volume_progressbar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:elevation="8dp"
                android:max="10"
                android:progress="4"
                android:progressDrawable="@drawable/remote_control_imagebutton_background_progressbar"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_telecoil_image_button"
                app:layout_constraintStart_toEndOf="@id/remote_control_max_output_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_max_output_progressbar" />

            <ImageButton
                android:id="@+id/remote_control_volume_up_image_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/remote_control_button_ripple_round_top_background"
                android:elevation="8dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_volume_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_volume_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_volume_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_volume_progressbar" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:elevation="8dp"
                android:src="@drawable/remote_control_ic_up_24dp"
                app:layout_constraintEnd_toEndOf="@id/remote_control_volume_up_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_volume_up_image_button"
                app:layout_constraintTop_toTopOf="@id/remote_control_volume_up_image_button" />

            <ImageButton
                android:id="@+id/remote_control_volume_down_image_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/remote_control_button_ripple_round_bottom_background"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_volume_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_volume_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_volume_progressbar"
                app:layout_constraintTop_toBottomOf="@id/remote_control_volume_up_image_button" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent"
                android:elevation="8dp"
                android:src="@drawable/remote_control_ic_down_24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_volume_down_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_volume_down_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_volume_down_image_button" />

            <TextView
                android:id="@+id/remote_control_volume_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="볼륨"
                android:textColor="@color/white_70"
                android:textSize="14dp"
                app:layout_constraintBottom_toTopOf="@id/remote_control_volume_up_image_button"
                app:layout_constraintEnd_toEndOf="@id/remote_control_volume_up_image_button"
                app:layout_constraintStart_toStartOf="@id/remote_control_volume_up_image_button" />

            <TextView
                android:id="@+id/remote_control_volume_value_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:text=""
                android:textColor="@color/black_90"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="@id/remote_control_volume_progressbar"
                app:layout_constraintEnd_toEndOf="@id/remote_control_volume_progressbar"
                app:layout_constraintStart_toStartOf="@id/remote_control_volume_progressbar"
                app:layout_constraintTop_toTopOf="@id/remote_control_volume_progressbar"
                tools:text="10" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Connection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/remote_control_connection_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/black_70"
            android:clickable="true"
            android:gravity="center"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/remote_control_progressbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:indeterminate="true"
                app:indicatorColor="@color/accent_70"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:trackColor="@color/black_30" />

            <TextView
                android:id="@+id/remote_control_connection_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:elevation="8dp"
                android:lineSpacingMultiplier="1.4"
                android:padding="16dp"
                android:text="앱에 등록된 사용자 및 사운드처리기 정보를 바탕으로 연결이 가능한 사운드처리기를 검색합니다.\n\n사운드처리기가 꺼져있거나, 등록된 사용자 및 사운드처리기 정보가 올바르지 않으면 연결될 수 없습니다."
                android:textAlignment="center"
                android:textColor="@color/white_90"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/remote_control_progressbar"
                app:layout_constraintVertical_bias="0.3" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>