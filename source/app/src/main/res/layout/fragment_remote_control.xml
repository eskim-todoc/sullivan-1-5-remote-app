        <!-- Connection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/remote_control_connection_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <!--
            <com.github.mmin18.widget.RealtimeBlurView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:realtimeBlurRadius="8dp"
                app:realtimeOverlayColor="#8000" />
                -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/remote_control_find_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.9"
                android:background="@color/black_70"
                android:clickable="true"
                android:gravity="center"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone">

                <com.skyfishjy.library.RippleBackground
                    android:id="@+id/remote_control_searching_animator"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:rb_color="@color/accent_10"
                    app:rb_duration="2000"
                    app:rb_radius="8dp"
                    app:rb_rippleAmount="1"
                    app:rb_scale="30">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/item_user_ic_person_40dp"
                        android:visibility="invisible" />
                </com.skyfishjy.library.RippleBackground>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/remote_control_progressbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:elevation="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/accent_70"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:trackColor="@color/black_30" />

                <TextView
                    android:id="@+id/remote_control_connection_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:elevation="8dp"
                    android:lineSpacingMultiplier="1.5"
                    android:padding="16dp"
                    android:text="외부기를 머리에 부착한 상태에서\n장치 연결을 진행하세요."
                    android:textAlignment="center"
                    android:textColor="@color/white_90"
                    android:textSize="14dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_progressbar"
                    app:layout_constraintVertical_bias="0.35" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <!-- Blur -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/remote_control_blur_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible"></androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>