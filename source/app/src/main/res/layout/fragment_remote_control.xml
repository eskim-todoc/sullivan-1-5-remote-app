<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary"
        tools:context="todoc.cochlear.remoteapp.fragment.RemoteControlFragment">

        <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- Users -->
        <LinearLayout
            android:id="@+id/remote_control_user_list_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/remote_control_user_list_title_textview"
                style="@style/remote_control_button_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="사용자 목록"
                android:textAlignment="textStart" />

            <HorizontalScrollView
                android:id="@+id/remote_control_chip_group_scrollview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/remote_control_chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:singleLine="true"
                    app:singleSelection="true">

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Body -->
        <LinearLayout
            android:id="@+id/remote_control_body_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Battery -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/remote_control_battery_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="3">

                <TextView
                    android:id="@+id/remote_control_battery_percent_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanum_gothic_regular"
                    android:text="22%"
                    android:textColor="@color/color_secondary"
                    android:textSize="64dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- On/Off buttons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/remote_control_on_off_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/remote_control_notification_title_textview"
                    style="@style/remote_control_button_title_textview"
                    android:text="알림"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_notification_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_notification_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_notification_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <ImageButton
                    android:id="@+id/remote_control_notification_image_button"
                    style="@style/remote_control_circle_image_button"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/remote_control_ic_notifications_24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/remote_control_led_image_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_notification_title_textview" />

                <TextView
                    android:id="@+id/remote_control_led_title_textview"
                    style="@style/remote_control_button_title_textview"
                    android:text="LED"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_led_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_led_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_led_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <ImageButton
                    android:id="@+id/remote_control_led_image_button"
                    style="@style/remote_control_circle_image_button"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/remote_control_ic_light_24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/remote_control_telecoil_image_button"
                    app:layout_constraintStart_toEndOf="@id/remote_control_notification_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_led_title_textview" />

                <TextView
                    android:id="@+id/remote_control_telecoil_title_textview"
                    style="@style/remote_control_button_title_textview"
                    android:text="텔레코일"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_telecoil_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_telecoil_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_telecoil_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <ImageButton
                    android:id="@+id/remote_control_telecoil_image_button"
                    style="@style/remote_control_circle_image_button"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/remote_control_ic_telecoil_24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/remote_control_led_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_telecoil_title_textview" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Up down buttons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/remote_control_up_down_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="2">

                <TextView
                    android:id="@+id/remote_control_max_output_value_textview"
                    style="@style/remote_control_button_title_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanum_gothic_regular"
                    android:gravity="center"
                    android:text="100%"
                    android:textColor="@color/color_on_primary"
                    android:textSize="32dp"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_max_output_title_textview"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/remote_control_max_output_title_textview"
                    style="@style/remote_control_button_title_textview"
                    android:layout_marginTop="24dp"
                    android:text="최대출력"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_max_output_up_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_max_output_value_textview" />

                <ImageButton
                    android:id="@+id/remote_control_max_output_up_image_button"
                    style="@style/remote_control_up_image_button"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_max_output_title_textview" />

                <ImageButton
                    android:id="@+id/remote_control_max_output_down_image_button"
                    style="@style/remote_control_down_image_button"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_max_output_up_image_button" />

                <TextView
                    android:id="@+id/remote_control_volume_value_textview"
                    style="@style/remote_control_button_title_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanum_gothic_regular"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="@color/color_on_primary"
                    android:textSize="32dp"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_volume_title_textview"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/remote_control_volume_title_textview"
                    style="@style/remote_control_button_title_textview"
                    android:layout_marginTop="24dp"
                    android:text="볼륨"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_volume_up_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_volume_value_textview" />

                <ImageButton
                    android:id="@+id/remote_control_volume_up_image_button"
                    style="@style/remote_control_up_image_button"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_volume_title_textview" />

                <ImageButton
                    android:id="@+id/remote_control_volume_down_image_button"
                    style="@style/remote_control_down_image_button"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintStart_toEndOf="@id/remote_control_max_output_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_volume_up_image_button" />

                <TextView
                    android:id="@+id/remote_control_program_value_textview"
                    style="@style/remote_control_button_title_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanum_gothic_regular"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/color_on_primary"
                    android:textSize="32dp"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_program_title_textview"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/remote_control_program_title_textview"
                    style="@style/remote_control_button_title_textview"
                    android:layout_marginTop="24dp"
                    android:text="프로그램"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_program_up_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_program_value_textview" />

                <ImageButton
                    android:id="@+id/remote_control_program_up_image_button"
                    style="@style/remote_control_up_image_button"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toTopOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintEnd_toEndOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintStart_toStartOf="@id/remote_control_program_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_program_title_textview" />

                <ImageButton
                    android:id="@+id/remote_control_program_down_image_button"
                    style="@style/remote_control_down_image_button"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/remote_control_volume_down_image_button"
                    app:layout_constraintTop_toBottomOf="@id/remote_control_program_up_image_button" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- Connection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/remote_control_connection_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/color_primary"
            android:gravity="center"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/remote_control_connection_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.4"
                android:text="선택한 사용자를 기반으로\n사운드처리기 검색 및 연결합니다."
                android:textAlignment="center"
                android:textColor="@color/color_on_primary"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/remote_control_progressbar"
                app:layout_constraintVertical_bias="0.4" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/remote_control_progressbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:elevation="8dp"
                android:indeterminate="true"
                app:indicatorColor="@color/color_error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:trackColor="@color/color_on_primary" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>