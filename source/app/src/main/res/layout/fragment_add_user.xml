<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/remote_control_background_glass" android:overScrollMode="never" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:clipToPadding="false" tools:context="todoc.cochlear.remoteapp.fragment.AddUserFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="입력" android:textColor="@color/white_70" android:textSize="@dimen/type_body" android:visibility="gone" android:fontFamily="@font/ibm_plex_sans_kr" android:includeFontPadding="false" />
      <LinearLayout android:id="@+id/form_fields_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/remote_glass_panel" android:padding="12dp">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="0dp" app:counterEnabled="false" app:boxBackgroundColor="@android:color/transparent" app:boxBackgroundMode="none">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/name_edittext" android:layout_width="match_parent" android:layout_height="48dp" android:hint="사용자 이니셜" android:inputType="text" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:fontFamily="@font/ibm_plex_sans_kr" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@null" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="0dp" app:counterEnabled="false" app:counterMaxLength="4" app:boxBackgroundColor="@android:color/transparent" app:boxBackgroundMode="none">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/passkey_edittext" android:layout_width="match_parent" android:layout_height="48dp" android:hint="내부기 키" android:inputType="none" android:maxLength="4" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:fontFamily="@font/ibm_plex_sans_kr" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@null" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="0dp" app:counterEnabled="false" app:counterMaxLength="10" app:boxBackgroundColor="@android:color/transparent" app:boxBackgroundMode="none">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/nickname_edittext" android:layout_width="match_parent" android:layout_height="48dp" android:hint="내부기 별칭" android:inputType="text" android:maxLength="10" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:fontFamily="@font/ibm_plex_sans_kr" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@null" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="착용 위치" android:textColor="@color/white_70" android:textSize="@dimen/type_body" android:fontFamily="@font/ibm_plex_sans_kr" android:includeFontPadding="false" />
      <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/left_radiobutton" style="@style/Widget.MaterialComponents.CompoundButton.RadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" android:text="왼쪽" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/ibm_plex_sans_kr" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" android:minHeight="44dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/right_radiobutton" style="@style/Widget.MaterialComponents.CompoundButton.RadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" android:text="오른쪽" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/ibm_plex_sans_kr" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" android:minHeight="44dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
        <!-- 착용 위치가 아니라 맵 데이터가 공장 초기화된 외부기를 뜻한다. -->
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/factory_reset_radiobutton" style="@style/Widget.MaterialComponents.CompoundButton.RadioButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" android:text="초기화" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/ibm_plex_sans_kr" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" android:minHeight="44dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
      </RadioGroup>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="옵션" android:textColor="@color/white_70" android:textSize="@dimen/type_body" android:fontFamily="@font/ibm_plex_sans_kr" android:includeFontPadding="false" />
      <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/default_checkbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기본 사용자로 등록" android:textColor="@color/white_90" android:textSize="@dimen/type_body" app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false" android:minHeight="44dp" android:includeFontPadding="false" android:fontFamily="@font/ibm_plex_sans_kr" android:paddingTop="0dp" android:paddingBottom="0dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.1" android:text="* 사용자 이니셜은 병원에서 제공.\n* 내부기 키는 병원에서 제공한 4자리 번호." android:textColor="@color/white_80" android:textSize="@dimen/type_body" android:textStyle="bold" android:visibility="visible" android:fontFamily="@font/ibm_plex_sans_kr" android:includeFontPadding="false" />
      <com.google.android.material.button.MaterialButton android:id="@+id/add_button" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:minHeight="44dp" android:text="등록" android:textAlignment="center" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/ibm_plex_sans_kr" android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginBottom="6dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
    </LinearLayout>
  </ScrollView>
</layout>