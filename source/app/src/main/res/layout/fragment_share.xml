<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_70"
        android:padding="16dp"
        tools:context="todoc.cochlear.remoteapp.fragment.ShareFragment">

        <!-- 진행순서 설명화면 -->
        <ScrollView
            android:id="@+id/share_process_explain_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 설명서 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/share_explain_manual_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="외부기에 여러 내부기의 매핑 데이터를 저장하여, 외부기를 사용자간 공유할 수 있게 합니다."
                        android:textAlignment="textStart"
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toTopOf="@id/share_explain_warning_desc_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_explain_warning_start_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/accent_40"
                        android:textSize="14dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/share_explain_warning_desc_tv" />

                    <TextView
                        android:id="@+id/share_explain_warning_desc_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="매핑 데이터 공유 절차 진행 동안에는 사용자들이 같은 공간에 있어야 합니다."
                        android:textColor="@color/accent_40"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_warning_start_tv"
                        app:layout_constraintTop_toBottomOf="@id/share_explain_manual_tv" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 진행 순서 텍스트 뷰 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/share_title_textview_background"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="진행순서"
                    android:textColor="@color/white_90"
                    android:textSize="14dp" />

                <!-- 내부기 선택 박스 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/share_desc_textview_background"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/share_explain_select_isd_number_tv"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="1."
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_explain_select_isd_title_tv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/share_explain_select_isd_title_tv" />

                    <TextView
                        android:id="@+id/share_explain_select_isd_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="내부기 선택"
                        android:textAlignment="textStart"
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toTopOf="@id/share_explain_select_isd_desc_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_select_isd_number_tv"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_explain_select_isd_star_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/white_70"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_explain_select_isd_desc_tv"
                        app:layout_constraintStart_toStartOf="@id/share_explain_select_isd_title_tv"
                        app:layout_constraintTop_toTopOf="@id/share_explain_select_isd_desc_tv" />

                    <TextView
                        android:id="@+id/share_explain_select_isd_desc_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="매핑 데이터 공유 절차 진행 동안에는 사용자들이 같은 공간에 있어야 합니다."
                        android:textColor="@color/white_70"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_select_isd_star_tv"
                        app:layout_constraintTop_toBottomOf="@id/share_explain_select_isd_title_tv" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 매핑 데이터 수집 박스 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/share_desc_textview_background"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/share_explain_collect_map_data_number_tv"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="2."
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_explain_collect_map_data_title_tv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/share_explain_collect_map_data_title_tv" />

                    <TextView
                        android:id="@+id/share_explain_collect_map_data_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="매핑 데이터 수집"
                        android:textAlignment="textStart"
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toTopOf="@id/share_explain_collect_map_data_desc_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_collect_map_data_number_tv"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_explain_collect_map_data_star_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/white_70"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_explain_collect_map_data_desc_tv"
                        app:layout_constraintStart_toStartOf="@id/share_explain_collect_map_data_title_tv"
                        app:layout_constraintTop_toTopOf="@id/share_explain_collect_map_data_desc_tv" />

                    <TextView
                        android:id="@+id/share_explain_collect_map_data_desc_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="각 외부기에 보관된 내부기 매핑 데이터를 리모컨으로 가져옵니다."
                        android:textColor="@color/white_70"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_collect_map_data_star_tv"
                        app:layout_constraintTop_toBottomOf="@id/share_explain_collect_map_data_title_tv" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 매핑 데이터 공유 박스 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/share_desc_textview_background"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/share_explain_distribute_map_data_number_tv"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="3."
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_explain_distribute_map_data_title_tv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/share_explain_distribute_map_data_title_tv" />

                    <TextView
                        android:id="@+id/share_explain_distribute_map_data_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="매핑 데이터 공유"
                        android:textAlignment="textStart"
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toTopOf="@id/share_explain_distribute_map_data_desc_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_distribute_map_data_number_tv"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_explain_distribute_map_data_star_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/white_70"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_explain_distribute_map_data_desc_tv"
                        app:layout_constraintStart_toStartOf="@id/share_explain_distribute_map_data_title_tv"
                        app:layout_constraintTop_toTopOf="@id/share_explain_distribute_map_data_desc_tv" />

                    <TextView
                        android:id="@+id/share_explain_distribute_map_data_desc_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="리모컨에 수집된 매핑 데이터들을 외부기로 전송합니다."
                        android:textColor="@color/white_70"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_explain_distribute_map_data_star_tv"
                        app:layout_constraintTop_toBottomOf="@id/share_explain_distribute_map_data_title_tv" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 진행 버튼 -->
                <Button
                    android:id="@+id/share_explain_start_button"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/accent_70"
                    android:minHeight="56dp"
                    android:text="진행"
                    android:textAlignment="center"
                    android:textColor="@color/black_90" />

                <!-- 외부기 맵 데이터 초기화 버튼 -->
                <Button
                    android:id="@+id/share_explain_init_map_data_button"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="외부기 맵 데이터 초기화"
                    android:textAlignment="center"
                    android:textColor="@color/black_90" />
            </LinearLayout>
        </ScrollView>

        <!-- 1. 내부기 선택 화면 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/share_select_isd_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 설명서 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/share_select_isd_manual_number_tv"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="1."
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_select_isd_manual_title_tv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_select_isd_manual_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="내부기 선택\n(공유하고자 하는 내부기를 선택합니다.)"
                        android:textAlignment="textStart"
                        android:textColor="@color/white_90"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toTopOf="@id/share_select_isd_warning_desc_1_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_select_isd_manual_number_tv"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/share_select_isd_warning_star_1_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/accent_40"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_select_isd_warning_desc_1_tv"
                        app:layout_constraintStart_toStartOf="@id/share_select_isd_manual_title_tv"
                        app:layout_constraintTop_toTopOf="@id/share_select_isd_warning_desc_1_tv" />

                    <TextView
                        android:id="@+id/share_select_isd_warning_desc_1_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="원하는 내부기가 목록에 없을 경우, 사용자 등록을 먼저 진행해주세요."
                        android:textColor="@color/accent_40"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_select_isd_warning_star_1_tv"
                        app:layout_constraintTop_toBottomOf="@id/share_select_isd_manual_title_tv" />

                    <TextView
                        android:id="@+id/share_select_isd_warning_star_2_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/accent_40"
                        android:textSize="14dp"
                        app:layout_constraintEnd_toStartOf="@id/share_select_isd_warning_desc_2_tv"
                        app:layout_constraintStart_toStartOf="@id/share_select_isd_warning_star_1_tv"
                        app:layout_constraintTop_toTopOf="@id/share_select_isd_warning_desc_2_tv" />

                    <TextView
                        android:id="@+id/share_select_isd_warning_desc_2_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="최대 4개의 내부기를 선택할 수 있습니다."
                        android:textColor="@color/accent_40"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/share_select_isd_warning_star_2_tv"
                        app:layout_constraintTop_toBottomOf="@id/share_select_isd_warning_desc_1_tv" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 사용자 목록 카테고리 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:background="@color/black_80"
                        android:padding="4dp"
                        android:text="사용자 이니셜"
                        android:textAlignment="center"
                        android:textColor="@color/white_90"
                        android:textSize="14dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/black_80"
                        android:padding="4dp"
                        android:text="수술 부위"
                        android:textAlignment="center"
                        android:textColor="@color/white_90"
                        android:textSize="14dp" />

                    <CheckBox
                        android:layout_width="wrap_content"
                        android:layout_height="8dp"
                        android:clickable="false"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- 사용자 목록 리사이클러 뷰 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/share_select_isd_user_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_share_select_user" />

                <!-- 다음 절차 진행 버튼-->
                <Button
                    android:id="@+id/share_select_isd_next_step_button"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/accent_70"
                    android:minHeight="56dp"
                    android:text="다음 절차 진행"
                    android:textAlignment="center"
                    android:textColor="@color/black_90" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 2. 매핑 데이터 수집 -->
        <ScrollView
            android:id="@+id/share_collect_map_data_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="외부기에 여러 내부기의 매핑 데이터를 저장하여, 외부기를 사용자간 공유할 수 있게 합니다."
                    android:textColor="@color/white_90"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/accent_40"
                        android:textSize="14dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="매핑 데이터 공유 절차 진행 동안에는 사용자들이 같은 공간에 있어야 합니다."
                        android:textColor="@color/accent_40"
                        android:textSize="14dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 3. 매핑 데이터 공유 -->
        <ScrollView
            android:id="@+id/share_distribute_map_data_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:text="외부기에 여러 내부기의 매핑 데이터를 저장하여, 외부기를 사용자간 공유할 수 있게 합니다."
                    android:textColor="@color/white_90"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="*"
                        android:textColor="@color/accent_40"
                        android:textSize="14dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="매핑 데이터 공유 절차 진행 동안에는 사용자들이 같은 공간에 있어야 합니다."
                        android:textColor="@color/accent_40"
                        android:textSize="14dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>