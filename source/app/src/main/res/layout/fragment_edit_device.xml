<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/remote_control_background_glass"
        android:overScrollMode="never"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="24dp" android:clipToPadding="false"
        tools:context="todoc.cochlear.remoteapp.fragment.EditDeviceFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="입력"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body"
                android:visibility="gone" android:fontFamily="@font/pretendard" />

<LinearLayout android:id="@+id/form_fields_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/remote_glass_panel" android:padding="12dp">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:enabled="true"
                android:focusable="false"
                android:hint="제조번호"
                android:padding="0dp" app:counterEnabled="true" app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_device_serial_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:enabled="true"
                    android:focusable="false"
                    android:inputType="text"  android:textSize="@dimen/type_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="페어링 키"
                android:padding="0dp" app:counterEnabled="true"
                app:counterMaxLength="6" app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_devie_pairing_key_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6"  android:textSize="@dimen/type_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="표시 이름 (옵션)"
                android:padding="0dp" app:counterEnabled="true"
                app:counterMaxLength="10" app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_device_option_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="10"  android:textSize="@dimen/type_input" />
            </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.4"
                android:text="* 제조번호 수정 불가.\n* 페어링 키는 외부기 뒷면에 표시."
                android:textColor="@color/white_80"
                android:textSize="@dimen/type_body"
                android:textStyle="bold"
                android:visibility="visible" android:fontFamily="@font/pretendard" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_device_del_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="삭제"
                    android:textAlignment="center"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_danger" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_device_edit_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="수정"
                    android:textAlignment="center"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>