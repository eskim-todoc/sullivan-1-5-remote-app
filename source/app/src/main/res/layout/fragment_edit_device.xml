<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/remote_control_background_glass" android:overScrollMode="never" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:clipToPadding="false" tools:context="todoc.cochlear.remoteapp.fragment.EditDeviceFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="입력" android:textColor="@color/white_70" android:textSize="@dimen/type_body" android:visibility="gone" android:fontFamily="@font/app_sans" android:includeFontPadding="false" />
      <LinearLayout android:id="@+id/form_fields_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/remote_glass_panel" android:padding="12dp">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="false" android:enabled="true" android:focusable="false" android:hint="제조번호" android:padding="0dp" app:counterEnabled="false" app:boxBackgroundColor="@android:color/transparent" app:boxBackgroundMode="none">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_device_serial_edittext" android:layout_width="match_parent" android:layout_height="48dp" android:clickable="false" android:enabled="true" android:focusable="false" android:inputType="text" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:fontFamily="@font/app_sans" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@null" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="페어링 키" android:padding="0dp" app:counterEnabled="false" app:counterMaxLength="6" app:boxBackgroundColor="@android:color/transparent" app:boxBackgroundMode="none">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_devie_pairing_key_edittext" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="number" android:maxLength="6" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:fontFamily="@font/app_sans" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@null" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="표시 이름 (옵션)" android:padding="0dp" app:counterEnabled="false" app:counterMaxLength="10" app:boxBackgroundColor="@android:color/transparent" app:boxBackgroundMode="none">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_device_option_edittext" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="text" android:maxLength="10" android:textSize="@dimen/type_input" android:includeFontPadding="false" android:fontFamily="@font/app_sans" android:minHeight="48dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:paddingTop="12dp" android:paddingBottom="4dp" android:background="@null" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.1" android:text="* 제조번호 수정 불가.\n* 페어링 키는 외부기 뒷면에 표시." android:textColor="@color/white_80" android:textSize="@dimen/type_body" android:textStyle="bold" android:visibility="visible" android:fontFamily="@font/app_sans" android:includeFontPadding="false" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/edit_device_del_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:minHeight="44dp" android:text="삭제" android:textAlignment="center" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:background="@drawable/app_glass_danger" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/edit_device_edit_button" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:minHeight="44dp" android:text="수정" android:textAlignment="center" android:textColor="@color/white_90" android:textSize="@dimen/type_body" android:fontFamily="@font/app_sans" android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</layout>