<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/remote_control_background_glass"
        android:overScrollMode="never"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="24dp" android:clipToPadding="false"
        tools:context="todoc.cochlear.remoteapp.fragment.EditUserFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="입력"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body"
                android:visibility="gone" android:fontFamily="@font/pretendard" />

<LinearLayout android:id="@+id/form_fields_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/remote_glass_panel" android:padding="12dp">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:enabled="true"
                android:focusable="false"
                android:padding="0dp" app:counterEnabled="true" app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:enabled="true"
                    android:focusable="false"
                    android:hint="사용자 이니셜"
                    android:inputType="text"  android:textSize="@dimen/type_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="0dp" app:counterEnabled="true"
                app:counterMaxLength="4" app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_passkey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="내부기 키"
                    android:inputType="none"
                    android:maxLength="4"  android:textSize="@dimen/type_input" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="0dp" app:counterEnabled="true"
                app:counterMaxLength="10" app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="내부기 별칭"
                    android:inputType="text"
                    android:maxLength="10"  android:textSize="@dimen/type_input" />
            </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="착용 위치"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/edit_user_left_radiobutton"
                    style="@style/Widget.MaterialComponents.CompoundButton.RadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:text="왼쪽"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false"  android:minHeight="48dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/edit_user_right_radiobutton"
                    style="@style/Widget.MaterialComponents.CompoundButton.RadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:text="오른쪽"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false"  android:minHeight="48dp" />

                <!-- 착용 위치가 아니라 맵 데이터가 공장 초기화된 외부기를 뜻한다. -->
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/edit_user_factory_reset_radiobutton"
                    style="@style/Widget.MaterialComponents.CompoundButton.RadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:text="초기화"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false"  android:minHeight="48dp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="옵션"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox_default_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기본 사용자로 등록"
                android:textColor="@color/white_90"
                android:textSize="@dimen/type_body"  app:buttonTint="@color/glass_choice_tint" app:useMaterialThemeColors="false"  android:minHeight="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.4"
                android:text="* 사용자 이니셜 및 착용 위치 수정 불가.\n* 내부기 키는 병원에서 제공한 4자리 번호."
                android:textColor="@color/white_80"
                android:textSize="@dimen/type_body"
                android:textStyle="bold"
                android:visibility="visible" android:fontFamily="@font/pretendard" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_user_del_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="삭제"
                    android:textAlignment="center"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_danger" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_user_edit_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="수정"
                    android:textAlignment="center"
                    android:textColor="@color/white_90"
                    android:textSize="@dimen/type_body" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</layout>