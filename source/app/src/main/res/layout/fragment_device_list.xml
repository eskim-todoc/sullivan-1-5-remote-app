<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="todoc.cochlear.remoteapp.fragment.DeviceListFragment">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dimen_line_width_height_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_line_width_height_size"
                android:contentDescription="@string/warning_message_image_content_description"
                android:src="@color/color_line_color" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/fragment_device_list_layout_title_registered_devices"
                android:textAlignment="textStart"
                android:textColor="@color/color_small_title_text_color"
                android:textSize="@dimen/dimen_small_title_text_size_sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_line_width_height_size"
                android:contentDescription="@string/warning_message_image_content_description"
                android:src="@color/color_line_color"
                android:visibility="gone" />

            <ListView
                android:id="@+id/device_list_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0px"
                tools:ignore="NestedScrolling" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_line_width_height_size"
        android:contentDescription="@string/warning_message_image_content_description"
        android:src="@color/color_line_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>