<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/management_list_row_ripple">

    <LinearLayout
        android:id="@+id/user_summary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/name"
            style="@style/TextAppearance.App.ManagementListPrimary"
            android:layout_width="112dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/user_alias"
            style="@style/TextAppearance.App.ManagementListAlias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:minHeight="0dp" />

        <FrameLayout android:layout_width="32dp" android:layout_height="match_parent">
            <TextView
                android:id="@+id/user_left_active"
                style="@style/Widget.App.ManagementRegisteredBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:text="L" />
        </FrameLayout>

        <FrameLayout android:layout_width="32dp" android:layout_height="match_parent">
            <TextView
                android:id="@+id/user_right_active"
                style="@style/Widget.App.ManagementRegisteredBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:text="R" />
        </FrameLayout>

        <FrameLayout android:layout_width="32dp" android:layout_height="match_parent">
            <TextView
                android:id="@+id/user_factory_active"
                style="@style/Widget.App.ManagementRegisteredBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:text="F" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#2899AAA5"
        android:importantForAccessibility="no" />
</LinearLayout>