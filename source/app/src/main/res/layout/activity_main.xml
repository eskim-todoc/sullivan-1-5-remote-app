<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    배경색은 시스템 바(상태바 · 내비게이션바) 영역에 그대로 드러난다.
    안드로이드 15부터 앱이 시스템 바 아래까지 그리게 되면서, 루트에 인셋만큼 여백을 주면
    그 여백 부분이 이 배경색으로 칠해지기 때문이다.
    status_bar 와 bottom_navigation 이 모두 black_90 이므로 같은 색을 사용한다.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/status_bar"
        tools:context=".MainActivity">

        <!-- Main screen -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar"
                android:background="@drawable/remote_appbar_glass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:elevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    app:menu="@menu/toolbar"
                    app:navigationIcon="@drawable/toolbar_ic_back_arrow_24dp"
                    app:titleCentered="true" app:contentInsetStartWithNavigation="56dp" app:contentInsetEnd="16dp" app:titleMarginStart="0dp" app:navigationContentDescription="이전 화면으로" app:titleTextAppearance="@style/TextAppearance.App.PageTitle"
                    app:titleTextColor="@color/white_90"
                    tools:title="화면">

                </com.google.android.material.appbar.MaterialToolbar>

            </com.google.android.material.appbar.AppBarLayout>
            <TextView
                android:id="@+id/toolbar_navigation_message"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_marginStart="56dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center_vertical"

                android:maxLines="1" android:singleLine="true" android:ellipsize="end"
                android:text="뒤로"
                android:textColor="@color/accent_50"
                android:textSize="@dimen/type_body"
                android:textStyle="bold"
                android:visibility="visible"
                android:fontFamily="@font/app_sans" />



            <FrameLayout
                android:id="@+id/frame"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appbar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Pairing Key screen -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pairing_key_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/black_90"
                android:gravity="center"
                android:padding="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="등록된 페어링 키 : "
                    android:textColor="@color/white_70"
                    android:textSize="14dp" android:fontFamily="@font/app_sans" />

                <TextView
                    android:id="@+id/pairing_key_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/accent_70"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    tools:text="123456" android:fontFamily="@font/app_sans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white_70"
                    android:textSize="14dp" android:fontFamily="@font/app_sans" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
