<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/remote_control_background_glass"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="24dp"
        tools:context="todoc.cochlear.remoteapp.fragment.SettingsFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="보안"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body"
                android:visibility="gone" android:fontFamily="@font/pretendard" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_lock_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="화면 잠금"
                android:textColor="@color/white_90"
                android:textSize="@dimen/type_body"
                app:switchMinWidth="56dp" android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="등록관리"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body"
                android:visibility="gone" android:fontFamily="@font/pretendard" />

            <Button
                android:id="@+id/button_user"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_button_user"
                android:textAlignment="textStart"
                android:textColor="@color/white_90"
                android:textSize="@dimen/type_body"
                app:icon="@drawable/settings_ic_arrow_24dp"
                app:iconGravity="end"
                app:iconTint="@color/white_90" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/button_device"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_button_device"
                android:textAlignment="textStart"
                android:textColor="@color/white_90"
                android:textSize="@dimen/type_body"
                app:icon="@drawable/settings_ic_arrow_24dp"
                app:iconGravity="end"
                app:iconTint="@color/white_90" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="고객지원"
                android:textColor="@color/white_70"
                android:textSize="@dimen/type_body"
                android:visibility="gone" android:fontFamily="@font/pretendard" />

            <Button
                android:id="@+id/button_manual"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_button_manual"
                android:textAlignment="textStart"
                android:textColor="@color/white_90"
                app:icon="@drawable/settings_ic_arrow_24dp"
                app:iconGravity="end"
                app:iconTint="@color/white_90" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/settings_check_conn_ote_info_button"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="연결된 외부기 정보 확인"
                android:textAlignment="textStart"
                android:textColor="@color/white_90"
                app:icon="@drawable/settings_ic_arrow_24dp"
                app:iconGravity="end"
                app:iconTint="@color/white_90" android:fontFamily="@font/pretendard"  android:background="@drawable/app_glass_action" app:backgroundTint="@null" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />
        </LinearLayout>
    </ScrollView>
</layout>