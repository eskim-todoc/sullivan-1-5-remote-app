<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_ripple">
  <item>
  <selector>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0445580" />
            <stroke android:width="2dp" android:color="#FFC1CDFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4753647D" android:endColor="#1F222D3C" />
            <stroke android:width="1dp" android:color="#658F9DBB" />
            <corners android:radius="12dp" />
        </shape>
    </item>
  </selector>
  </item>
  <item android:id="@android:id/mask">
    <shape android:shape="rectangle">
      <solid android:color="#FFFFFFFF" />
      <corners android:radius="12dp" />
    </shape>
  </item>
</ripple>
