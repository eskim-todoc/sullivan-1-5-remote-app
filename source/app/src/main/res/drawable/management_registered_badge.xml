<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/glass_selected_fill" />
            <stroke android:width="1dp" android:color="#BAB3BCFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass_unselected_fill" />
            <stroke android:width="1dp" android:color="@color/glass_unselected_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
