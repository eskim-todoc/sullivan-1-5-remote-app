<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <gradient android:angle="90" android:startColor="#4D465984" android:endColor="#666577A9" />
                    <stroke android:width="1dp" android:color="#E6C3CCFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:angle="90" android:startColor="#30323E50" android:endColor="#454B5973" />
                    <stroke android:width="1dp" android:color="#668A98B8" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask"><shape><solid android:color="#FFFFFFFF" /><corners android:radius="28dp" /></shape></item>
</ripple>
